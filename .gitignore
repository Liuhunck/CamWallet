# Pico SDK / CMake generated files
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
.pico-sdk/
*.uf2
*.elf
*.map
*.o
*.obj

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
