# Keep the shared VS Code configuration required by the Pico extension
**/.vscode/*
!**/.vscode/c_cpp_properties.json
!**/.vscode/cmake-kits.json
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/settings.json
!**/.vscode/tasks.json

# Logs, temporary files, and OS metadata
*.log
*.tmp
*~
.DS_Store
Thumbs.db
Desktop.ini
